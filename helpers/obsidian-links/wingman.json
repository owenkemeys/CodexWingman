{
  "schemaVersion": 2,
  "id": "obsidian-links",
  "name": "Obsidian links",
  "version": "1.5.0",
  "description": "Turns configured Obsidian note paths in rendered messages into safe deep links.",
  "refreshSeconds": 0,
  "capabilities": [
    "system.openObsidianUri"
  ],
  "config": {
    "mappings": [],
    "uriAction": "open"
  },
  "targets": {
    "codex": {
      "apply": "apply.js",
      "remove": "remove.js"
    },
    "t3-code": {
      "apply": "apply.js",
      "remove": "remove.js"
    },
    "t3-web": {
      "apply": "apply.js",
      "remove": "remove.js"
    }
  }
}
